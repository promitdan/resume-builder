{
  "id": "minimal",
  "name": "Minimal",
  "layout": {
    "type": "single-column",
    "pageMarginTop": "0",
    "pageMarginSides": "0",
    "sectionSpacing": "32px",
    "itemSpacing": "20px"
  },
  "colors": {
    "mainBackground": "#ffffff",
    "mainText": "#222222",
    "headingText": "#111111",
    "accentColor": "#aaaaaa",
    "dividerColor": "#eeeeee",
    "mutedText": "#999999"
  },
  "palettes": [
    { "label": "Default", "swatch": "#111111", "colors": {} },
    { "label": "Navy",    "swatch": "#1e3a5f", "colors": { "headingText": "#1e3a5f" } },
    { "label": "Forest",  "swatch": "#14532d", "colors": { "headingText": "#14532d" } },
    { "label": "Rose",    "swatch": "#9f1239", "colors": { "headingText": "#9f1239" } },
    { "label": "Slate",   "swatch": "#334155", "colors": { "headingText": "#334155" } }
  ],
  "typography": {
    "nameFont": "Inter, sans-serif",
    "nameFontSize": "40px",
    "nameFontWeight": "300",
    "titleFont": "Inter, sans-serif",
    "titleFontSize": "17px",
    "sectionLabelFont": "Inter, sans-serif",
    "sectionLabelSize": "11px",
    "sectionLabelStyle": "uppercase",
    "sectionLabelSpacing": "3px",
    "bodyFont": "Inter, sans-serif",
    "bodyFontSize": "14px",
    "bodyLineHeight": "1.65"
  },
  "header": { "placement": "top-left", "alignment": "left", "showAvatar": false, "dividerStyle": "none" },
  "sections": {
    "type": "single-column",
    "order": ["personal", "experience", "skills", "education", "projects", "certifications", "awards", "languages", "custom"],
    "dividerStyle": "none", "bulletStyle": "none", "dateAlignment": "inline-right", "labelWeight": "normal"
  }
}
